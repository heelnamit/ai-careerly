# Supabase PostgreSQL connection string
# Add the pooled/direct connection string from Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# AI provider - we'll configure this in the AI milestone
OPENAI_API_KEY=""

# Apify - we'll configure this in the job ingestion milestone
APIFY_API_TOKEN=""
APIFY_LINKEDIN_ACTOR_ID=""

# Dashboard access. Use a password of at least 16 characters and a random
# session secret of at least 32 characters. Never expose either as NEXT_PUBLIC_*.
DASHBOARD_PASSWORD=""
DASHBOARD_SESSION_SECRET=""

# Optional key for trusted server-to-server job-search/import/agent requests
INTERNAL_API_KEY=""

# Optional app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
